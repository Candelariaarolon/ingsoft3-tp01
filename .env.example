# Para docker-compose. Copiar a .env y completar — docker compose lo lee
# solo de acá y lo reparte a los dos servicios, así JWT_SECRET no se puede
# desincronizar entre backend y frontend.
JWT_SECRET=""

# Password de Postgres. Cualquier valor sirve para una base nueva — pero una
# vez que el volumen se creó con un valor, cambiarlo acá no lo actualiza en
# la base ya existente (Postgres solo lo aplica al inicializar el volumen).
POSTGRES_PASSWORD=""

AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_VERSION=""
AZURE_OPENAI_DEPLOYMENT_NAME=""
