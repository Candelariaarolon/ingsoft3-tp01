# Copiar a .env y completar.

# Mismo valor que JWT_SECRET en backend/.env.example.
JWT_SECRET=""

# A dónde reenviar /api/* — el backend suelto en tu máquina, o el hostname
# del servicio "backend" si corrés esto vía docker-compose.
BACKEND_URL="http://localhost:4000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
