# Copiar a .env y completar.

# Conexión a Postgres. Con docker-compose no hace falta tocarla (ya viene
# configurada para el servicio "db" del compose); para correr el backend
# suelto en tu máquina, apuntá a un Postgres local.
DATABASE_URL="postgresql://postgres:curatta@localhost:5433/curatta"

# Secreto de firma de sesión (JWT), cualquier string largo random sirve.
# TIENE que ser el mismo valor que JWT_SECRET en frontend/.env.example.
JWT_SECRET=""

# Azure OpenAI Vision (análisis de fotos para el matching en /buscar).
# Sin esto, publicar sigue funcionando (la publicación queda sin analizar)
# y /buscar devuelve error de análisis en vez de resultados — no bloquea el
# resto de la app.
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_VERSION=""
AZURE_OPENAI_DEPLOYMENT_NAME=""
